CREATE TABLE listening_resource (
    resource_key TEXT NOT NULL PRIMARY KEY,
    resource_type TEXT NOT NULL,
    source_id TEXT NOT NULL,
    source_resource_id TEXT NOT NULL,
    title TEXT NOT NULL,
    subtitle TEXT NOT NULL,
    cover_url TEXT,
    metadata_json TEXT,
    updated_at INTEGER NOT NULL
);

CREATE INDEX listening_resource_type_idx ON listening_resource(resource_type);
CREATE INDEX listening_resource_source_idx ON listening_resource(source_id, source_resource_id);

CREATE TABLE listening_event (
    session_key TEXT NOT NULL PRIMARY KEY,
    primary_resource_key TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    ended_at INTEGER,
    played_ms INTEGER NOT NULL,
    duration_ms INTEGER,
    qualified INTEGER NOT NULL,
    start_reason TEXT NOT NULL,
    completion_reason TEXT,
    context_session_key TEXT,
    updated_at INTEGER NOT NULL
);

CREATE INDEX listening_event_started_at_idx ON listening_event(started_at DESC);
CREATE INDEX listening_event_qualified_started_idx ON listening_event(qualified, started_at DESC);
CREATE INDEX listening_event_primary_started_idx ON listening_event(primary_resource_key, started_at DESC);

CREATE TABLE listening_event_resource (
    session_key TEXT NOT NULL,
    resource_key TEXT NOT NULL,
    relation_type TEXT NOT NULL,
    PRIMARY KEY (session_key, resource_key, relation_type)
);

CREATE INDEX listening_event_resource_resource_idx ON listening_event_resource(resource_key, relation_type);

upsertResource:
INSERT OR REPLACE INTO listening_resource(
    resource_key,
    resource_type,
    source_id,
    source_resource_id,
    title,
    subtitle,
    cover_url,
    metadata_json,
    updated_at
) VALUES (
    :resourceKey,
    :resourceType,
    :sourceId,
    :sourceResourceId,
    :title,
    :subtitle,
    :coverUrl,
    :metadataJson,
    :updatedAt
);

upsertEvent:
INSERT OR REPLACE INTO listening_event(
    session_key,
    primary_resource_key,
    started_at,
    ended_at,
    played_ms,
    duration_ms,
    qualified,
    start_reason,
    completion_reason,
    context_session_key,
    updated_at
) VALUES (
    :sessionKey,
    :primaryResourceKey,
    :startedAt,
    :endedAt,
    :playedMs,
    :durationMs,
    :qualified,
    :startReason,
    :completionReason,
    :contextSessionKey,
    :updatedAt
);

deleteEventRelations:
DELETE FROM listening_event_resource
WHERE session_key = :sessionKey;

insertEventRelation:
INSERT OR REPLACE INTO listening_event_resource(
    session_key,
    resource_key,
    relation_type
) VALUES (
    :sessionKey,
    :resourceKey,
    :relationType
);

countEvents:
SELECT COUNT(*) FROM listening_event;

clearEventRelations:
DELETE FROM listening_event_resource;

clearEvents:
DELETE FROM listening_event;

clearResources:
DELETE FROM listening_resource;
